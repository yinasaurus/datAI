# Copy this file to role2/.env and fill in the key. Never commit .env.

# Gemini. The model name is read from here. It is not hardcoded in Python.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Sample database from docker compose. Role 1 will change the database name if needed.
DATABASE_URL=postgresql://olist:olist@localhost:5432/olist

# Evaluation switches. Role 4 can override these in code without editing .env.
SCHEMA_MODE=rag
AGENT_MODE=agent_loop
MAX_REPAIRS=3
GUARDRAILS=on
TEMPERATURE=0
SEED=42
SCHEMA_K=4
LOG_PATH=logs/runs.jsonl
